NODE_ENV=development
PORT=3000
MONGODB_URI=
# Facultatif : vide conserve la base de l'URI ; renseigné la remplace explicitement.
# Base applicative distincte de la base d'authentification authSource dans l'URI.
MONGODB_DB=
# auto : transactions replica set/mongos ; standalone sérialisé, sans rollback.
# required : refuser standalone (recommandé en production).
MONGODB_TRANSACTIONS=auto
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# En production, true exige SMTP ; false autorise inscription/connexion et invites sans SMTP.
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY=0
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT=30
# Entier 1..10000 : permet uniquement de réduire le plafond par face.
CARD_TEXT_MAX_LENGTH=10000
# Facultatif : liens devResetUrl/devVerificationUrl en development/test uniquement.
# En production sans SMTP : recuperation indisponible (503), aucun lien de developpement.
# Avec SMTP_HOST : MAIL_FROM valide requis, USER/PASS ensemble (ou tous deux absents).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=