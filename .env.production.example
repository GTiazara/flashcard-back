# Copier vers .env.production (ignore par Git). Ne pas deployer ces exemples tels quels.
BACKEND_HOST=flashcardback.skippylab.com
MONGODB_URI=
# Vide : base de l'URI. authSource doit rester dans MONGODB_URI si necessaire.
MONGODB_DB=
# auto pour votre standalone (un seul processus API, pas de rollback).
# required pour exiger un replica set et ses transactions.
MONGODB_TRANSACTIONS=auto
SESSION_SECRET=
# Exemple de domaine personnalise Pages, A REMPLACER par votre origine reelle.
FRONTEND_URL=https://flashcard.skippylab.com
CORS_ORIGIN=https://flashcard.skippylab.com
TRUST_PROXY=1
# true exige SMTP en production ; false permet inscription/connexion et invites sans SMTP.
REQUIRE_EMAIL_VERIFICATION=false
SESSION_TTL_SECONDS=604800
AUTH_RATE_LIMIT=30
CARD_TEXT_MAX_LENGTH=10000
# Facultatif si confirmation desactivee : laisser HOST/USER/PASS/MAIL_FROM tous vides.
# Sans SMTP : recuperation indisponible (503), aucun lien de developpement.
# Avec SMTP_HOST : MAIL_FROM valide requis, USER/PASS ensemble (ou tous deux absents).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Le seed mnemo n'est pas dans l'image et ne lit pas ce fichier : voir README.